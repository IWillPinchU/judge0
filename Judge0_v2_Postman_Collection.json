        {
          "name": "GET Retrieve Single Test Case Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/suites/test_cases/{{test_case_token}}",
              "host": ["{{base_url}}"],
              "path": ["suites", "test_cases", "{{test_case_token}}"]
            },
            "description": "Fetches execution telemetry (time, memory, stdout, stderr, exit_code) for a single test case within a suite."
          }
        },
        {
          "name": "POST Suite - Java 21 OpenJDK Verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language_id\": 62,\n  \"source_code\": \"import java.util.Scanner;\\npublic class Main {\\n    public static void main(String[] args) {\\n        Scanner sc = new Scanner(System.in);\\n        while (sc.hasNextInt()) {\\n            int n = sc.nextInt();\\n            System.out.println(n * n);\\n        }\\n    }\\n}\",\n  \"test_cases\": [\n    {\n      \"stdin\": \"5\\n\",\n      \"expected_output\": \"25\\n\"\n    },\n    {\n      \"stdin\": \"10\\n\",\n      \"expected_output\": \"100\\n\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/suites?wait=true",
              "host": ["{{base_url}}"],
              "path": ["suites"],
              "query": [
                {
                  "key": "wait",
                  "value": "true"
                }
              ]
            },
            "description": "Executes Java 21 suite. Verifies Cgroup v2 physical RSS memory enforcement and ActiveProcessorCount thread throttling."
          }
        },
        {
          "name": "POST Suite - CE Fail-Fast Short-Circuit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language_id\": 54,\n  \"source_code\": \"#include <iostream>\\nint main() { INVALID_SYNTAX_ERROR return 0; }\",\n  \"test_cases\": [\n    {\n      \"stdin\": \"1\\n\",\n      \"expected_output\": \"1\\n\"\n    },\n    {\n      \"stdin\": \"2\\n\",\n      \"expected_output\": \"2\\n\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/suites?wait=true",
              "host": ["{{base_url}}"],
              "path": ["suites"],
              "query": [
                {
                  "key": "wait",
                  "value": "true"
                }
              ]
            },
            "description": "Demonstrates compilation error short-circuiting: compilation aborts in <1s, suppresses empty test case bloat, and runs 0 test cases."
          }
        }
      ]
    },
