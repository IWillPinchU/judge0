    {
      "name": "2. Compile-Once Suite Engine (/suites)",
      "item": [
        {
          "name": "POST Create Suite (Synchronous wait=true)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('suite_token', res.token); }",
                  "if (res.test_cases && res.test_cases.length > 0) { pm.collectionVariables.set('test_case_token', res.test_cases[0].token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language_id\": 54,\n  \"source_code\": \"#include <iostream>\\nint main() {\\n    int a, b;\\n    if (std::cin >> a >> b) {\\n        std::cout << (a + b) << std::endl;\\n    }\\n    return 0;\\n}\",\n  \"test_cases\": [\n    {\n      \"stdin\": \"10 20\\n\",\n      \"expected_output\": \"30\\n\"\n    },\n    {\n      \"stdin\": \"100 250\\n\",\n      \"expected_output\": \"350\\n\"\n    },\n    {\n      \"stdin\": \"-5 15\\n\",\n      \"expected_output\": \"10\\n\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/suites?wait=true",
              "host": ["{{base_url}}"],
              "path": ["suites"],
              "query": [
                {
                  "key": "wait",
                  "value": "true"
                }
              ]
            },
            "description": "Compiles C++ code ONCE and runs 3 test cases sequentially. Returns complete suite status and per-test results synchronously."
          }
        },
        {
          "name": "POST Create Suite (Asynchronous wait=false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) { pm.collectionVariables.set('suite_token', res.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language_id\": 71,\n  \"source_code\": \"import sys\\nfor line in sys.stdin:\\n    parts = line.strip().split()\\n    if len(parts) >= 2:\\n        print(int(parts[0]) * int(parts[1]))\",\n  \"test_cases\": [\n    {\n      \"stdin\": \"4 5\\n\",\n      \"expected_output\": \"20\\n\"\n    },\n    {\n      \"stdin\": \"12 12\\n\",\n      \"expected_output\": \"144\\n\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/suites?wait=false",
              "host": ["{{base_url}}"],
              "path": ["suites"],
              "query": [
                {
                  "key": "wait",
                  "value": "false"
                }
              ]
            },
            "description": "Submits Python suite asynchronously and immediately returns suite token in ~5ms."
          }
        },
        {
          "name": "GET Retrieve Suite by Token",
          "request": {
            "method": "GET",
            "header": [],
